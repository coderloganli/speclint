{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet --project \"${CLAUDE_PLUGIN_ROOT}\" speclint hook",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
